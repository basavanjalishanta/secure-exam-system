# Copy to backend/.env and fill in your real values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
PORT=5000
CORS_ORIGINS=http://localhost:5173

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=secure_exam_system

JWT_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL_HOURS=12

# Gmail email OTP (second login step)
# Use a Google App Password, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=yourgmail@gmail.com
EMAIL_OTP_TTL_MINUTES=5

# Ollama runs locally; no hosted AI API key is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.2
AES_KEY_B64=
