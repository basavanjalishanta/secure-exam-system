# =====================================================================
#  Secure Exam Question Paper Management System - backend environment
#  Copy to  backend/.env  and fill in real values. NEVER commit .env.
# =====================================================================

# ---------- Flask ----------
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false
PORT=5000
CORS_ORIGINS=http://localhost:5173

# ---------- MongoDB ----------
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=secure_exam_system

# ---------- JWT ----------
JWT_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL_HOURS=12

# ---------- Email login verification ----------
# Use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=yourgmail@gmail.com
EMAIL_OTP_TTL_MINUTES=5

# ---------- AES-256 encryption for generated papers ----------
# Provide ONE of the following: a 32-byte key, base64- OR hex-encoded.
# Generate:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY_B64=
AES_KEY_HEX=

# ---------- File uploads ----------
UPLOAD_DIR=uploads
ENCRYPTED_DIR=encrypted_papers
MAX_CONTENT_MB=40

# ---------- AI provider ----------
# ollama -> local Ollama generation; mock is for development/testing only.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.2

# ---------- Embeddings ----------
# hash                  -> deterministic local fallback, zero extra deps
# sentence-transformers -> local model (pip install sentence-transformers)
# llama                 -> Ollama embeddings endpoint
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------- RAG / dedup tuning ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=6
DUPLICATE_THRESHOLD=0.86

# ---------- Seed accounts (optional; random passwords are generated if unset) ----------
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
SEED_LECTURER_EMAIL=lecturer@example.edu
SEED_LECTURER_PASSWORD=
